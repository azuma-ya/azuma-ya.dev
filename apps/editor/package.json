{
  "name": "editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check --write *",
    "pages:build": "bunx @cloudflare/next-on-pages",
    "preview": "bun run pages:build && wrangler pages dev",
    "deploy": "bun run pages:build && wrangler pages deploy",
    "generate": "drizzle-kit generate",
    "local:migration": "wrangler d1 migrations apply azumaya-blog-editor-db --local",
    "remote:migration": "wrangler d1 migrations apply azumaya-blog-editor-db --remote"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@hono/zod-validator": "^0.9.1",
    "@repo/markdown": "*",
    "@repo/ui": "*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@repo/typescript-config": "*",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
